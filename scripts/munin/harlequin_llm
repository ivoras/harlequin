#!/usr/bin/env python3
r"""Munin multigraph plugin: Harlequin LLM call stats.

Reads the server's per-call lines from the journal, e.g.
  llm[chat]: done model=m prompt=80839 cached=71200 completion=278 ttft_ms=3100 total_ms=7300 cost_usd=0.0012 ok=true
(-1 = not reported by the provider). Counters are kept cumulatively in the
plugin state file and reported as DERIVE; latency and cache-hit rate are
averages over the lines seen since the previous fetch.

Install:
  ln -s /srv/harlequin/scripts/munin/harlequin_llm /etc/munin/plugins/
  printf '[harlequin_llm]\ngroup systemd-journal\n' > /etc/munin/plugin-conf.d/harlequin_llm
  systemctl restart munin-node
Env: unit (default harlequin.service).
"""
import json
import os
import re
import subprocess
import sys

UNIT = os.environ.get("unit", "harlequin.service")
STATE = os.path.join(os.environ.get("MUNIN_PLUGSTATE", "/tmp"), "harlequin_llm.json")
LINE = re.compile(r"llm\[[^\]]*\]: done (.*)$")
COUNTERS = ("calls", "failed", "prompt", "cached", "completion", "cost_micro")

CONFIG = """multigraph harlequin_llm_calls
graph_title Harlequin LLM calls
graph_vlabel calls per minute
graph_category harlequin
graph_period minute
graph_args --base 1000 -l 0
calls.label Calls
calls.type DERIVE
calls.min 0
failed.label Failed
failed.type DERIVE
failed.min 0

multigraph harlequin_llm_tokens
graph_title Harlequin LLM tokens
graph_vlabel tokens per minute
graph_category harlequin
graph_period minute
graph_args --base 1000 -l 0
prompt.label Prompt
prompt.type DERIVE
prompt.min 0
cached.label Prompt (cached)
cached.type DERIVE
cached.min 0
completion.label Generated
completion.type DERIVE
completion.min 0

multigraph harlequin_llm_latency
graph_title Harlequin LLM latency
graph_vlabel seconds
graph_category harlequin
graph_args --base 1000 -l 0
graph_info Averages over the calls finished in each interval.
ttft.label Time to first token (avg)
ttft.type GAUGE
total.label Call duration (avg)
total.type GAUGE
total_max.label Call duration (max)
total_max.type GAUGE

multigraph harlequin_llm_cache
graph_title Harlequin LLM prompt cache hit rate
graph_vlabel % of prompt tokens
graph_category harlequin
graph_args --base 1000 -l 0 -u 100 -r
hit.label Cached share of prompt tokens
hit.type GAUGE
hit.min 0
hit.max 100

multigraph harlequin_llm_cost
graph_title Harlequin LLM cost (provider-reported)
graph_vlabel USD per hour
graph_category harlequin
graph_period hour
graph_args --base 1000 -l 0
cost.label Cost
cost.type DERIVE
cost.min 0
cost.cdef cost,1000000,/
"""


def parse(fields):
    kv = dict(f.split("=", 1) for f in fields.split() if "=" in f)
    num = lambda k: float(kv.get(k, "-1"))
    return {
        "ok": kv.get("ok") == "true",
        "prompt": num("prompt"), "cached": num("cached"), "completion": num("completion"),
        "ttft_ms": num("ttft_ms"), "total_ms": num("total_ms"), "cost": num("cost_usd"),
    }


def journal(cursor):
    base = ["journalctl", "-u", UNIT, "-o", "cat", "--no-pager", "--show-cursor"]
    args = base + (["--after-cursor", cursor] if cursor else ["--since", "-5min"])
    r = subprocess.run(args, capture_output=True, text=True)
    if r.returncode != 0 and cursor:  # cursor vacuumed away: resync
        r = subprocess.run(base + ["--since", "-5min"], capture_output=True, text=True)
    lines, new_cursor = [], cursor
    for ln in r.stdout.splitlines():
        if ln.startswith("-- cursor: "):
            new_cursor = ln[len("-- cursor: "):]
        else:
            lines.append(ln)
    return lines, new_cursor


def update(state, lines):
    """Fold new lines into the cumulative counters; return interval values."""
    c = state["counters"]
    ttft, total, prompt_sum, cached_sum = [], [], 0, 0
    for ln in lines:
        m = LINE.search(ln)
        if not m:
            continue
        s = parse(m.group(1))
        c["calls"] += 1
        if not s["ok"]:
            c["failed"] += 1
        for k in ("prompt", "cached", "completion"):
            if s[k] > 0:
                c[k] += int(s[k])
        if s["cost"] > 0:
            c["cost_micro"] += int(round(s["cost"] * 1e6))
        if s["ok"] and s["ttft_ms"] >= 0:
            ttft.append(s["ttft_ms"] / 1000)
        if s["ok"] and s["total_ms"] >= 0:
            total.append(s["total_ms"] / 1000)
        if s["prompt"] > 0 and s["cached"] >= 0:
            prompt_sum += s["prompt"]
            cached_sum += s["cached"]
    avg = lambda xs: "%.3f" % (sum(xs) / len(xs)) if xs else "U"
    return {
        "ttft": avg(ttft), "total": avg(total), "total_max": "%.3f" % max(total) if total else "U",
        "hit": "%.1f" % (100 * cached_sum / prompt_sum) if prompt_sum else "U",
    }


def fetch():
    try:
        with open(STATE) as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = {}
    state.setdefault("cursor", "")
    state.setdefault("counters", {})
    for k in COUNTERS:
        state["counters"].setdefault(k, 0)
    lines, state["cursor"] = journal(state["cursor"])
    iv = update(state, lines)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, STATE)
    c = state["counters"]
    print("multigraph harlequin_llm_calls\ncalls.value %d\nfailed.value %d" % (c["calls"], c["failed"]))
    print("multigraph harlequin_llm_tokens\nprompt.value %d\ncached.value %d\ncompletion.value %d"
          % (c["prompt"], c["cached"], c["completion"]))
    print("multigraph harlequin_llm_latency\nttft.value %s\ntotal.value %s\ntotal_max.value %s"
          % (iv["ttft"], iv["total"], iv["total_max"]))
    print("multigraph harlequin_llm_cache\nhit.value %s" % iv["hit"])
    print("multigraph harlequin_llm_cost\ncost.value %d" % c["cost_micro"])


def selftest():
    st = {"counters": dict.fromkeys(COUNTERS, 0)}
    iv = update(st, [
        "llm[chat]: done model=m prompt=100 cached=60 completion=7 ttft_ms=400 total_ms=1500 cost_usd=0.00012 ok=true",
        "llm[chat]: done model=m prompt=-1 cached=-1 completion=-1 ttft_ms=-1 total_ms=1000 cost_usd=-1 ok=false",
        "llm[chat]: model m, ~5 prompt tokens, idle timeout 1m0s (avg PP 1 tok/s)",
    ])
    c = st["counters"]
    assert (c["calls"], c["failed"], c["prompt"], c["cached"], c["cost_micro"]) == (2, 1, 100, 60, 120), c
    assert iv == {"ttft": "0.400", "total": "1.500", "total_max": "1.500", "hit": "60.0"}, iv
    print("ok")


if __name__ == "__main__":
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "config":
        print(CONFIG, end="")
    elif arg == "autoconf":
        print("yes")
    elif arg == "selftest":
        selftest()
    else:
        fetch()
